    {
        "id": "fe1e5319fdc6554b",
        "type": "function",
        "z": "a65f1d125d17f35a",
        "name": "Meter Range",
        "func": "var msg1 = {};\nvar scale = msg.scale;\nvar label;\n\nif (scale == undefined)\n    scale = 5;\n    \nswitch (scale)\n{\n    case 5:  // 5W\n        msg1.control = { min: 0, max: 5, seg1: 2.5};\n        label = \"5W\";\n        break;\n    case 10:  // 10W\n        msg1.control = { min: 0, max: 10, seg1: 5 };\n        label = \"10W\";\n        break;\n    case 25:  // 25W\n        msg1.control = { min: 0, max: 30, seg1: 15 };\n        label = \"25W\";\n        break;\n    case 50:  // 50W\n        msg1.control = { min: 0, max: 50, seg1: 25};\n        label = \"50W\";\n        break;\n    case 100:  // 100W\n        msg1.control = { min: 0, max: 100, seg1: 50 };\n        label = \"100W\";\n        break;\n    case 250:  // 250W\n        msg1.control = { min: 0, max: 250, seg1: 125 };\n        label = \"250W\";\n        break;\n    case 500:  // 500W\n        msg1.control = { min: 0, max: 500, seg1: 250 };\n        label = \"500W\";\n        break;\n    case 1000:  // 1000W\n        msg1.control = { min: 0, max: 1000, seg1: 500 };\n        label = \"1000W\";\n        break;\n    case 2500:  // 2500W\n        msg1.control = { min: 0, max: 2.5, seg1: 1.25 };\n        label = \"2500W\";\n        break;\n    case 5000:  // 5KW\n        msg1.control = { min: 0, max: 5, seg1: 2.5 };\n        label = \"5KW\";\n        break;\n    case 10000:  // 10KW\n        msg1.control = { min: 0, max: 10, seg1: 5 };\n        label = \"5KW\";\n        break;\n}\n\nnode.status({ fill: \"black\", shape: \"ring\", text: label });\n\n\nreturn msg1;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
