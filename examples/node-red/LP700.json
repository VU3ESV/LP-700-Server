    {
        "id": "lp7parsefn00001",
        "type": "function",
        "z": "a65f1d125d17f35a",
        "name": "Parse WS frame",
        "func": "// Decode WS text \u2192 frame; pass telemetry data through, route\n// heartbeat to output 2 (live status), drop ack/status frames.\nlet frame;\ntry { frame = JSON.parse(msg.payload); } catch (e) { return null; }\nif (!frame || !frame.type) return null;\nif (frame.type === 'telemetry') {\n    return [{ payload: frame.data, seq: frame.seq, ts: frame.ts }, null];\n}\nif (frame.type === 'heartbeat') {\n    node.status({ fill: 'green', shape: 'dot', text: 'live \u00b7 seq ' + frame.seq });\n    return [null, { payload: frame.seq }];\n}\nreturn null;\n",
        "outputs": 2,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 600,
        "y": 540,
        "wires": [
            [
                "lp7reshape00001"
            ],
            [
                "lp7livedbg00001"
            ]
        ]
    },
    {
        "id": "lp7reshape00001",
        "type": "function",
        "z": "a65f1d125d17f35a",
        "name": "Reshape (KD4Z-compatible)",
        "func": "// Map lp700-server's parsed telemetry frame back to the flat\n// msg shape KD4Z's `LP Dice and Slice` emitted, so the existing\n// rbe / Peak Hold Logic / dashboard chain works unchanged.\nconst RANGE_NAMES = ['5W','10W','25W','50W','100W','250W','500W','1K','2.5K','5K','10K','auto'];\nconst RANGE_WATTS = [5, 10, 25, 50, 100, 250, 500, 1000, 2500, 5000, 10000, 0];\nconst TOP_MODES   = ['power_swr', 'waveform', 'spectrum', 'setup'];\n\nconst d = msg.payload || {};\nconst rangeIdx = RANGE_NAMES.indexOf(d.range);\nconst modeIdx  = TOP_MODES.indexOf(d.top_mode);\n\nmsg.power_avg  = (d.power_avg_w  || 0).toFixed(0);\nmsg.power_peak = (d.power_peak_w || 0).toFixed(0);\nmsg.swr        = (d.swr          || 1).toFixed(2);\nmsg.scale      = RANGE_WATTS[rangeIdx >= 0 ? rangeIdx : 0];\nmsg.mode       = modeIdx  >= 0 ? modeIdx  : 0;\nmsg.channel    = d.auto_channel ? 0 : (d.channel || 0);\nmsg.range      = rangeIdx >= 0 ? rangeIdx : 0;\n// keep the friendlier full frame for new consumers\nmsg.parsed     = d;\nreturn msg;\n",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 820,
        "y": 540,
        "wires": [
