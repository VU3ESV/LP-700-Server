    {
        "id": "0843cb1357243f45",
        "type": "function",
        "z": "a65f1d125d17f35a",
        "name": "Peak Hold Logic",
        "func": "var value = msg.power_peak;\nvar id = \"peak_hold\";\nvar cnt = 0.0;\nvar topic = \"\";\nvar reset;\n\n\nif (typeof msg.peakreset == \"undefined\") {\n    reset = false;\n}\nelse {\n    value = 0;\n    reset = msg.peakreset;\n}\n\nif (reset) {\n    cnt = 0;\n    node.status({ fill: \"red\", shape: \"ring\", text: \"Peak Reset\" });\n    context.set(id, cnt);\n    \n}\nelse {\n    cnt = parseFloat(context.get(id));  // get previous highwater mark\n    if (typeof cnt != 'number') {\n        cnt = 0;\n    }\n    node.status({ fill: \"green\", shape: \"ring\", text: \"LastPeak=\" + cnt });\n    if (value > cnt) {\n        cnt = value;\n    }\n}\n\ncontext.set(id, cnt);\n\n\nmsg.power_peak = cnt;\nreturn msg;\n",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1040,
        "y": 380,
        "wires": [
            [
                "91e6a68092389463"
            ]
        ]
    },
    {
        "id": "6e1a0ca4da2fc1b2",
        "type": "function",
        "z": "a65f1d125d17f35a",
        "name": "Peak Hold Logic",
        "func": "var value = msg.power_avg;\nvar id = \"peak_hold\";\nvar cnt = 0.0;\nvar topic = \"\";\nvar reset;\n\n\nif (typeof msg.peakreset == \"undefined\")\n{\n    reset = false;\n}\nelse\n{\n    value = 0;\n    reset = msg.peakreset;\n}\n\nif (reset)\n{\n    cnt = 0;\n    node.status({ fill: \"red\", shape: \"ring\", text: \"Peak Reset\" });\n    context.set(id, cnt);\n   \n}\nelse\n{\n    cnt = parseFloat(context.get(id)) ;  // get previous highwater mark\n    if (typeof cnt != 'number')\n    {\n        node.warn(\"cnt context not a number\");\n        cnt = 0;\n    }\n    node.status({ fill: \"green\", shape: \"ring\", text: \"LastPeak=\" + cnt });\n    if (value > cnt)\n    {\n        cnt = value;\n    }   \n}\n\ncontext.set(id, cnt);\n\n\nmsg.power_avg = cnt;\nreturn msg;\n",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1040,
        "y": 220,
        "wires": [
