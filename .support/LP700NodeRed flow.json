        "name": "Set  Range Label",
        "func": "switch (msg.range)\n{\n    case 0:\n        msg.payload = \"Range 5 W\";\n        break;\n    case 1:\n        msg.payload = \"Range 10 W\";\n        break;\n    case 2:\n        msg.payload = \"Range 25 W\";\n        break;\n    case 3:\n        msg.payload = \"Range 50 W\";\n        break;\n    case 4:\n        msg.payload = \"Range 100 W\";\n        break;\n    case 5:\n        msg.payload = \"Range 250 W\";\n        break;\n    case 6:\n        msg.payload = \"Range 500 W\";\n        break;\n    case 7:\n        msg.payload = \"Range 1 KW\";\n        break;\n    case 8:\n        msg.payload = \"Range 2.5 KW\";\n        break;\n    case 9:\n        msg.payload = \"Range 5 KW\";\n        break;\n    case 10:\n        msg.payload = \"Range 10 KW\";\n        break;\n    case 11:\n        var text = \"Range Auto\";\n        msg.payload = text;\n        break;\n}\nreturn msg;",
