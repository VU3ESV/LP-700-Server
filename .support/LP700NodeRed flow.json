    {
        "id": "5ace3b6bba2b1f93",
        "type": "function",
        "z": "a65f1d125d17f35a",
        "name": "LP Dice and Slice",
        "func": "/*\n\nOrdinates in VB are based 1, so subtract 1 from\n each ordinate to access correct buffer element\n\nlstResults.AddItem \"Pk Pwr Hi byte =\" & InputReportData(24)\nlstResults.AddItem \"Pk Pwr Lo byte =\" & InputReportData(25)\nlstResults.AddItem \"Avg Pwr Hi byte =\" & InputReportData(26)\nlstResults.AddItem \"Avg Pwr Lo byte =\" & InputReportData(27)\nlstResults.AddItem \"BG_avg =\" & InputReportData(28)\nlstResults.AddItem \"BG_pk =\" & InputReportData(29)\nlstResults.AddItem \"BG_SWR =\" & InputReportData(30)\n\nAvg_Pwr = InputReportData(26)\nAvg_Pwr = Avg_Pwr * 256\nAvg_Pwr = (Avg_Pwr + InputReportData(27)) * 2  \n\nPk_Pwr = InputReportData(24)\nPk_Pwr = Pk_Pwr * 256\nPk_Pwr = (Pk_Pwr + InputReportData(25)) * 2  \n\nSWR_Disp = Int(InputReportData(38) + InputReportData(3) * 256) / 100\n\n*/\n\nconst PKPWR_HIBYTE = 23\nconst PKPWR_LOBYTE = 24\nconst AVGPWR_HIBYTE = 25\nconst AVGPWR_LOBYTE = 26\nconst SWR_HIBYTE = 2\nconst SWR_LOBYTE = 37\nconst PWRMULT_HIBYTE = 30\nconst PWRMULT_LOBYTE = 31\nconst MODE = 3\nconst CHANNEL = 4\nconst RANGE = 6\nconst CHANNELAUTO = 5\n\nvar msg1 = {};\nvar buff = msg.payload;\nvar mode = buff[MODE];\nvar channel = buff[CHANNEL];\nvar channelauto = buff[CHANNELAUTO];\nvar range = buff[RANGE];\n\nvar mult    = ( (buff[PWRMULT_HIBYTE] * 256) + buff[PWRMULT_LOBYTE]) * 2;\n\nvar Avg_Pwr = ( (buff[AVGPWR_HIBYTE] * 256) + buff[AVGPWR_LOBYTE] ) * 2 / 10;\n\nvar Pk_Pwr  = ( (buff[PKPWR_HIBYTE]  * 256) + buff[PKPWR_LOBYTE]  ) * 2 / 10;\n\nvar SWR     = ( (buff[SWR_HIBYTE]    * 256) + buff[SWR_LOBYTE]  ) / 100;\n\n\nmsg1.power_avg = Avg_Pwr.toFixed(0);\nmsg1.power_peak = Pk_Pwr.toFixed(0);\nmsg1.swr = SWR.toFixed(2);\nmsg1.scale = mult / 4;\nmsg1.mode = mode;\nmsg1.channel = channel;\n//msg1.channel_auto = channelauto;\nmsg1.range = range;\n\n\nreturn msg1;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
