        "name": "to KW if needed",
        "func": "var range = msg.range;\n\nif (range == undefined)\n    range = 0;\n\nswitch (range)\n{\n    case 8:\n    case 9:\n    case 10:\n        msg.power_peak = msg.power_peak.toFixed(0);\n        msg.power_peak = msg.power_peak / 1000;\n    \n}\nmsg.payload = 0 // surpress errors \n\nreturn msg;",
